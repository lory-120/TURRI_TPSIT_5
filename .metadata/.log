	}
	public double getMediaVoti() {
		double sum = 0;
		int div = 0;
		for(Integer v : voti) {
			sum += v;
			div++;
		}
		
		return sum/div;
	}
	
	@Override
	public String toString() {
		return nome + ", di razza " + razza + ". E' di " + proprietario;
	}
	
}

